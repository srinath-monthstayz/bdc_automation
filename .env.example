# Airtable
AIRTABLE_PAT=

# Shared secret the GitHub Actions workflow sends as "Authorization: Bearer <value>"
# to the /api/cron/poll-booking-com endpoint. Generate any long random string.
CRON_SECRET=

# Gmail search query used to find new Booking.com notification emails.
# Default matches the real subject format if left unset:
# GMAIL_QUERY=from:noreply@booking.com subject:"New booking!"

# Gmail label (created automatically if missing) used to mark threads as handled so
# they aren't reprocessed on the next poll.
# GMAIL_LABEL_PROCESSED=gsg-booking-automation/processed

# Gmail API - OAuth2 client credentials + a refresh token for the mailbox that
# receives Booking.com notifications. See README "Gmail setup" for how to obtain these.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Google Calendar - a service account with write access to every property calendar,
# shared per-calendar (see README "Google Calendar setup").
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the service account JSON key file with real newlines
# replaced by \n (the code un-escapes them at runtime).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
